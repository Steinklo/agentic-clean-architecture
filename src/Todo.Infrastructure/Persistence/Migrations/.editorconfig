# Everything in this folder is emitted by `dotnet ef migrations add`, so its style is EF Core's
# choice, not ours. Without this the block-scoped namespace EF emits trips IDE0161, and
# TreatWarningsAsErrors turns that into a build failure on every new migration.
#
# Only the .Designer.cs and model snapshot carry an <auto-generated /> marker; the migration file
# itself does not, so Roslyn has no way to know. This tells it.

[*.cs]
generated_code = true
