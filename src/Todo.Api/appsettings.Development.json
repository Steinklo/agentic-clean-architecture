{
  // Development only. This file is never loaded outside the Development environment,
  // and the composed run overrides everything in it through environment variables -
  // see docker-compose.yml.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    // Points at the SQL Server that `docker compose up db` starts, so running the API
    // from an IDE needs no further setup. The password is a development-only literal,
    // committed on purpose and named so it cannot be mistaken for a real secret; a
    // deployed database's credentials belong in the platform's secret store, injected
    // as the ConnectionStrings__TodoDb environment variable.
    "TodoDb": "Server=localhost,1433;Database=Todo;User Id=sa;Password=LocalDevOnly_NotASecret1;Encrypt=True;TrustServerCertificate=True"
  },
  "Database": {
    // Apply pending migrations during startup. A convenience for development and not a
    // production pattern - DatabaseMigrator says why, and what to do instead.
    "MigrateOnStartup": true
  }
}
